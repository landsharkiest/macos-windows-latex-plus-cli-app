# AI Provider Configuration
# Choose your AI provider: 'openai' (cloud) or 'ollama' (local)
AI_PROVIDER=openai

# OpenAI Configuration (Cloud AI)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# Ollama Configuration (Local AI)
# Install Ollama: https://ollama.ai
# Then pull a model: ollama pull llama2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Available Ollama models:
# - llama2: General purpose
# - codellama: Code-focused (recommended for LaTeX)
# - mistral: Fast and capable
# - mixtral: High quality
# - neural-chat: Conversational
# Run 'ollama list' to see installed models

# To use AI features:
# 1. Copy this file to .env
# 2. Choose your provider (openai or ollama)
# 3. Configure the appropriate settings above
# 4. Restart the application

